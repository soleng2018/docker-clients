#!/bin/bash

# Script to generate docker-compose.yml files from parameters.txt

# Function to find USB device info from MAC address
find_usb_device() {
    local mac_address=$1
    
    if [ -z "$mac_address" ]; then
        echo ""
        return
    fi
    
    # Normalize MAC address for comparison
    local mac_lower=$(echo "$mac_address" | tr '[:upper:]' '[:lower:]')
    
    # Try to find the interface with this MAC
    local interface=""
    
    # Method 1: Use ip link
    interface=$(ip link show 2>/dev/null | grep -iB1 "$mac_lower" | head -1 | awk -F': ' '{print $2}' | awk '{print $1}')
    
    # Method 2: Use ifconfig if ip link didn't work
    if [ -z "$interface" ]; then
        interface=$(ifconfig 2>/dev/null | grep -iB1 "$mac_lower" | head -1 | awk '{print $1}' | tr -d ':')
    fi
    
    # Method 3: Check /sys/class/net directly
    if [ -z "$interface" ]; then
        for iface in /sys/class/net/*; do
            if [ -f "$iface/address" ]; then
                local iface_mac=$(cat "$iface/address" 2>/dev/null | tr '[:upper:]' '[:lower:]')
                if [ "$iface_mac" = "$mac_lower" ]; then
                    interface=$(basename "$iface")
                    break
                fi
            fi
        done
    fi
    
    local device_path=""
    local usb_device_dir=""
    
    # If interface found, get USB device path from interface
    if [ -n "$interface" ]; then
        device_path=$(readlink -f "/sys/class/net/$interface/device" 2>/dev/null)
        if [ -n "$device_path" ] && [ -d "$device_path" ]; then
            # Navigate up the directory tree to find USB device directory with busnum and devnum
            local current_dir="$device_path"
            while [ -n "$current_dir" ] && [ "$current_dir" != "/" ]; do
                # Check if this directory has busnum and devnum files (indicates it's a USB device)
                if [ -f "$current_dir/busnum" ] && [ -f "$current_dir/devnum" ]; then
                    usb_device_dir="$current_dir"
                    break
                fi
                # Move up one directory
                current_dir=$(dirname "$current_dir")
            done
        fi
    fi
    
    # Method 4: If not found via interface, check USB devices directly
    # This handles cases where USB device is already passed to a container
    if [ -z "$usb_device_dir" ]; then
        # Check all USB devices in /sys/bus/usb/devices
        for usb_dev_link in /sys/bus/usb/devices/*; do
            # Follow symlink to actual device path
            local usb_dev=$(readlink -f "$usb_dev_link" 2>/dev/null)
            if [ -z "$usb_dev" ] || [ ! -d "$usb_dev" ]; then
                continue
            fi
            
            # Check if this USB device has a network interface with matching MAC
            # Look for net subdirectories in the device path
            for net_dir in "$usb_dev"/*/net/* "$usb_dev"/*/*/net/*; do
                if [ -d "$net_dir" ] && [ -f "$net_dir/address" ]; then
                    local net_mac=$(cat "$net_dir/address" 2>/dev/null | tr '[:upper:]' '[:lower:]')
                    if [ "$net_mac" = "$mac_lower" ]; then
                        # Found matching MAC, navigate up to find USB device directory
                        local current_dir="$net_dir"
                        while [ -n "$current_dir" ] && [ "$current_dir" != "/" ]; do
                            if [ -f "$current_dir/busnum" ] && [ -f "$current_dir/devnum" ]; then
                                usb_device_dir="$current_dir"
                                break 2
                            fi
                            current_dir=$(dirname "$current_dir")
                        done
                    fi
                fi
            done
        done
    fi
    
    if [ -z "$usb_device_dir" ] || [ ! -f "$usb_device_dir/busnum" ] || [ ! -f "$usb_device_dir/devnum" ]; then
        echo ""
        return
    fi
    
    # Read bus and device numbers directly from USB device directory
    local bus=$(cat "$usb_device_dir/busnum" 2>/dev/null | xargs)
    local device=$(cat "$usb_device_dir/devnum" 2>/dev/null | xargs)
    
    if [ -n "$bus" ] && [ -n "$device" ]; then
        echo "hostbus=$bus,hostaddr=$device"
    else
        echo ""
    fi
}

# Function to check if traefik is installed
check_traefik_installed() {
    # Check if traefik container is running (primary check)
    if docker ps --format '{{.Names}}' | grep -qi traefik; then
        return 0
    fi
    
    # Check if traefik container exists (even if stopped)
    if docker ps -a --format '{{.Names}}' | grep -qi traefik; then
        return 0
    fi
    
    # Check if traefik binary exists (standalone installation)
    if command -v traefik &> /dev/null; then
        return 0
    fi
    
    # Note: We don't check for images alone, as having an image doesn't mean traefik is installed/running
    return 1
}

# Global settings. Defaults reproduce the previously hardcoded behaviour; any of
# them can be overridden with an UPPER_CASE line in parameters.txt, e.g.
#   CERT_RESOLVER = "letsencrypt"
TRAEFIK_NETWORK="traefik"      # docker network shared with Traefik/cloudflared
TRAEFIK_SUBNET=""              # e.g. 172.18.0.0/16 -- pinned when the network is created
CERT_RESOLVER="letsencrypt"
AUTH_MIDDLEWARE="authentik@file"
ENTRYPOINT="websecure"
REQUIRE_TRAEFIK="false"        # "true" = refuse to generate without Traefik (instead of silently omitting labels)

# VM names are lower-case by convention; UPPER_CASE keys are global settings.
# NOTE: deliberately a glob test, not a regex -- a regex match here would overwrite
# BASH_REMATCH, which the callers still need for the rest of the line.
is_global_key() { [[ "$1" == [[:upper:]]* && "$1" != *[![:upper:][:digit:]_]* ]]; }

apply_global() {
    local key=$1 value=$2
    case "$key" in
        TRAEFIK_NETWORK|TRAEFIK_SUBNET|CERT_RESOLVER|AUTH_MIDDLEWARE|ENTRYPOINT|REQUIRE_TRAEFIK)
            printf -v "$key" '%s' "$value" ;;
        *) echo "WARNING: unknown setting '$key' in parameters.txt (ignored)" >&2 ;;
    esac
}

# get_option <key> <param>...  -> prints the value of a "key=value" option token, if present
get_option() {
    local key=$1 tok
    shift
    for tok in "$@"; do
        tok=$(echo "$tok" | tr -d '"' | xargs)
        if [[ "$tok" == "$key="* ]]; then
            echo "${tok#"$key="}"
            return
        fi
    done
}

# Function to ensure traefik network exists
ensure_traefik_network() {
    if ! docker network inspect "$TRAEFIK_NETWORK" &> /dev/null; then
        echo "Creating $TRAEFIK_NETWORK network..."
        if [ -n "$TRAEFIK_SUBNET" ]; then
            docker network create --subnet "$TRAEFIK_SUBNET" "$TRAEFIK_NETWORK"
        else
            docker network create "$TRAEFIK_NETWORK"
        fi
    elif [ -n "$TRAEFIK_SUBNET" ]; then
        local actual
        actual=$(docker network inspect -f '{{range .IPAM.Config}}{{.Subnet}} {{end}}' "$TRAEFIK_NETWORK" 2>/dev/null)
        if [[ " $actual " != *" $TRAEFIK_SUBNET "* ]]; then
            echo "WARNING: network '$TRAEFIK_NETWORK' already exists with subnet(s) [${actual% }], not the configured TRAEFIK_SUBNET $TRAEFIK_SUBNET." >&2
            echo "         Static ip= addresses and any Cloudflare routes that assume $TRAEFIK_SUBNET may not match." >&2
        fi
    fi
}

# Function to generate docker-compose.yml content
generate_docker_compose() {
    local container_name=$1
    local os_type=$2
    local version=$3
    local ram_size=$4
    local cpu_cores=$5
    local username=$6
    local password=$7
    local port1=$8
    local port2=$9
    local domain=${10}
    local mac1=${11}
    local mac2=${12}
    local traefik_installed=${13}
    local host_override=${14}
    local static_ip=${15}

    # Compose project names must be lower-case [a-z0-9_-]. Setting this
    # explicitly (instead of letting compose derive it from the folder name,
    # "win1" in every workshop) stops one workshop's `up -d` from replacing
    # another workshop's same-named VM.
    local project_name
    project_name=$(echo "$container_name" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_\n-' '-')
    local fqdn="${host_override:-${container_name}.${domain}}"

    # dockurr/windows vs dockurr/macos: image name matches os_type directly.
    # Only these differ between the two images: USERNAME/PASSWORD support,
    # the remote-access port (RDP vs VNC), and the ./data bind mount.
    local remote_port="3389"
    if [ "$os_type" = "macos" ]; then
        remote_port="5900"
    fi

    # Find USB device info for MAC addresses
    local usb1=$(find_usb_device "$mac1")
    local usb2=$(find_usb_device "$mac2")
    
    # Build ARGUMENTS string
    local arguments=""
    local usb_device_line=""
    
    # If MAC addresses are provided, always include USB device support
    if [ -n "$mac1" ]; then
        if [ -n "$usb1" ]; then
            arguments="-device usb-host,$usb1"
            if [ -n "$mac2" ] && [ -n "$usb2" ]; then
                arguments="$arguments -device usb-host,$usb2"
            fi
        else
            # Auto-detection failed, add placeholder comment
            if [ -n "$mac2" ]; then
                arguments="-device usb-host,hostbus=X,hostaddr=Y -device usb-host,hostbus=X,hostaddr=Y # TODO: Configure USB devices for MAC $mac1 and $mac2. Use 'lsusb' and check /sys/bus/usb/devices to find hostbus and hostaddr"
            else
                arguments="-device usb-host,hostbus=X,hostaddr=Y # TODO: Configure USB device for MAC $mac1. Use 'lsusb' and check /sys/bus/usb/devices to find hostbus and hostaddr"
            fi
        fi
        usb_device_line="      - /dev/bus/usb # This line is only needed when passing USB"
    fi
    
    cat <<EOF
name: ${project_name}
services:
  ${os_type}:
    image: dockurr/${os_type}
    container_name: ${container_name}
    environment:
      VERSION: "${version}"
      RAM_SIZE: "${ram_size}"
      CPU_CORES: "${cpu_cores}"
EOF

    if [ "$os_type" = "windows" ]; then
        cat <<EOF
      USERNAME: "${username}"
      PASSWORD: "${password}"
EOF
    fi

    cat <<EOF
      #DHCP: "Y" # If using Static IP remove this line
EOF

    if [ -n "$arguments" ]; then
        echo "      ARGUMENTS: \"${arguments}\" # Passing USB Wireless NIC. Remove this line if no WiFi. Use lsusb to get vendorid and productid"
    fi
    
    cat <<EOF
    devices:
      - /dev/kvm
      - /dev/net/tun
      #- /dev/vhost-net # Only needed if DHCP="Y". For static remove this line
EOF

    if [ -n "$usb_device_line" ]; then
        echo "$usb_device_line"
    fi
    
    cat <<EOF
    #device_cgroup_rules: # Uncomment along with the rule below if DHCP="Y"
      #- 'c *:* rwm' # Only needed if DHCP="Y". For static remove this line
    cap_add:
      - NET_ADMIN
    ports:
      - ${port1}:8006
      - ${port2}:${remote_port}/tcp
      - ${port2}:${remote_port}/udp
    volumes:
      - ./${os_type}:/storage
EOF

    if [ "$os_type" = "windows" ]; then
        cat <<EOF
      - ./data:/data
EOF
    fi

    cat <<EOF
    restart: always
    stop_grace_period: 2m
EOF

    # Only include traefik labels if traefik is installed
    if [ "$traefik_installed" = "true" ]; then
        cat <<EOF
    labels:
      - traefik.enable=true
      # Main web interface route (with Authentik)
      - traefik.http.routers.${container_name}-web.rule=Host(\`${fqdn}\`) && !PathPrefix(\`/websockify\`)
      - traefik.http.routers.${container_name}-web.entrypoints=${ENTRYPOINT}
      - traefik.http.routers.${container_name}-web.tls=true
      - traefik.http.routers.${container_name}-web.tls.certresolver=${CERT_RESOLVER}
      - traefik.http.routers.${container_name}-web.service=${container_name}-svc
      - traefik.http.routers.${container_name}-web.middlewares=${AUTH_MIDDLEWARE}
      # WebSocket route (without Authentik)
      - traefik.http.routers.${container_name}-ws.rule=Host(\`${fqdn}\`) && PathPrefix(\`/websockify\`)
      - traefik.http.routers.${container_name}-ws.entrypoints=${ENTRYPOINT}
      - traefik.http.routers.${container_name}-ws.tls=true
      - traefik.http.routers.${container_name}-ws.tls.certresolver=${CERT_RESOLVER}
      - traefik.http.routers.${container_name}-ws.service=${container_name}-svc
      - traefik.http.routers.${container_name}-ws.middlewares=${container_name}-ws-headers
      # Service definition
      - traefik.http.services.${container_name}-svc.loadBalancer.server.port=8006
      - traefik.http.services.${container_name}-svc.loadBalancer.server.scheme=http
      # WebSocket headers middleware
      - traefik.http.middlewares.${container_name}-ws-headers.headers.customrequestheaders.Connection=upgrade
      - traefik.http.middlewares.${container_name}-ws-headers.headers.customrequestheaders.Upgrade=websocket
      - traefik.http.middlewares.${container_name}-ws-headers.headers.customrequestheaders.Sec-WebSocket-Version=13
EOF
    fi
    
    # Only include traefik network if traefik is installed
    if [ "$traefik_installed" = "true" ]; then
        if [ -n "$static_ip" ]; then
            cat <<EOF
    networks:
      ${TRAEFIK_NETWORK}:
        ipv4_address: ${static_ip}
EOF
        else
            cat <<EOF
    networks:
      - ${TRAEFIK_NETWORK}
EOF
        fi
        cat <<EOF

networks:
  ${TRAEFIK_NETWORK}:
    external: true
EOF
    fi
    
    echo ""
}

# Main script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PARAMETERS_FILE="$SCRIPT_DIR/parameters.txt"
# Each workshop is its own clone of this repo (e.g. /home/nova/nw3), so the
# folder name itself is the workshop identifier -- used to prefix every
# Docker container name / Traefik hostname (e.g. "win1" -> "nw3-win1")
# without needing that prefix typed into parameters.txt too.
WORKSHOP_NAME="$(basename "$SCRIPT_DIR")"

if [ ! -f "$PARAMETERS_FILE" ]; then
    echo "Error: parameters.txt not found in $SCRIPT_DIR"
    exit 1
fi

# Load global settings (UPPER_CASE = "value" lines) before anything else uses them
while IFS= read -r line || [ -n "$line" ]; do
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
    if [[ "$line" =~ ^([^=]+)=(.+)$ ]]; then
        key=$(echo "${BASH_REMATCH[1]}" | xargs)
        if is_global_key "$key"; then
            apply_global "$key" "$(echo "${BASH_REMATCH[2]}" | tr -d '"' | xargs)"
        fi
    fi
done < "$PARAMETERS_FILE"

# Check if traefik is installed
TRAEFIK_INSTALLED="false"
if check_traefik_installed; then
    TRAEFIK_INSTALLED="true"
    echo "Traefik is installed. Including traefik labels and network."
    # Ensure traefik network exists
    ensure_traefik_network
elif [ "$REQUIRE_TRAEFIK" = "true" ]; then
    echo "ERROR: REQUIRE_TRAEFIK is true but no Traefik was found. Start Traefik first (labs.sh), then re-run." >&2
    exit 1
else
    echo "WARNING: Traefik is not installed. Skipping traefik labels and network -- the generated"
    echo "         VMs will have NO web routes. Install Traefik and re-run to add them."
fi

# First pass: Validate port uniqueness
declare -A used_ports
declare -A container_ports
declare -A used_ips
validation_errors=0

echo "Validating port uniqueness..."

while IFS= read -r line || [ -n "$line" ]; do
    # Skip empty lines and comments
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
    
    # Parse line
    if [[ "$line" =~ ^([^=]+)=(.+)$ ]]; then
        container_name=$(echo "${BASH_REMATCH[1]}" | xargs)
        is_global_key "$container_name" && continue
        params=$(echo "${BASH_REMATCH[2]}" | xargs)

        # Parse parameters (remove quotes and split by comma)
        IFS=',' read -ra PARAMS <<< "$params"

        # Static IPs (optional ip= option) must be valid and unique within this clone
        vm_ip=$(get_option ip "${PARAMS[@]:9}")
        if [ -n "$vm_ip" ]; then
            if [[ ! "$vm_ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
                echo "ERROR: Container '$container_name' has an invalid ip= value '$vm_ip'."
                validation_errors=$((validation_errors + 1))
            elif [[ -n "${used_ips[$vm_ip]}" ]]; then
                echo "ERROR: IP $vm_ip is already used by container '${used_ips[$vm_ip]}'. Container '$container_name' cannot use the same IP."
                validation_errors=$((validation_errors + 1))
            else
                used_ips[$vm_ip]="$container_name"
            fi
        fi

        # Extract port values (remove quotes)
        # These are HOST ports - container port for port1 is always 8006;
        # port2's container-side port depends on os (3389 RDP / 5900 VNC)
        host_port1=$(echo "${PARAMS[6]}" | tr -d '"' | xargs)
        host_port2=$(echo "${PARAMS[7]}" | tr -d '"' | xargs)
        
        # Check host_port1 uniqueness (host ports must be unique)
        if [[ -n "${used_ports[$host_port1]}" ]]; then
            echo "ERROR: Host port $host_port1 is already used by container '${used_ports[$host_port1]}'. Container '$container_name' cannot use the same host port."
            validation_errors=$((validation_errors + 1))
        else
            used_ports[$host_port1]="$container_name"
        fi
        
        # Check host_port2 uniqueness (host ports must be unique)
        if [[ -n "${used_ports[$host_port2]}" ]]; then
            echo "ERROR: Host port $host_port2 is already used by container '${used_ports[$host_port2]}'. Container '$container_name' cannot use the same host port."
            validation_errors=$((validation_errors + 1))
        else
            used_ports[$host_port2]="$container_name"
        fi
        
        # Store ports for this container
        container_ports[$container_name]="$host_port1:$host_port2"
    fi
done < "$PARAMETERS_FILE"

# Exit if validation errors found
if [ $validation_errors -gt 0 ]; then
    echo ""
    echo "Port validation failed with $validation_errors error(s). Please fix parameters.txt and try again."
    exit 1
fi

echo "Port validation passed. All ports are unique."
echo ""

generated=()
skipped=()

# Read parameters.txt line by line
while IFS= read -r line || [ -n "$line" ]; do
    # Skip empty lines and comments
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
    
    # Parse line: win1 = "windows","11","4G","2","user","password","8006","3389","example.com","aa:bb:cc:dd:ee:01"[,"aa:bb:cc:dd:ee:02"][,"host=fqdn"][,"ip=172.18.x.y"]
    if [[ "$line" =~ ^([^=]+)=(.+)$ ]]; then
        container_name=$(echo "${BASH_REMATCH[1]}" | xargs)
        is_global_key "$container_name" && continue
        params=$(echo "${BASH_REMATCH[2]}" | xargs)

        # Parse parameters (remove quotes and split by comma)
        IFS=',' read -ra PARAMS <<< "$params"

        # Extract values (remove quotes)
        os_type=$(echo "${PARAMS[0]}" | tr -d '"' | xargs)
        version=$(echo "${PARAMS[1]}" | tr -d '"' | xargs)
        ram_size=$(echo "${PARAMS[2]}" | tr -d '"' | xargs)
        cpu_cores=$(echo "${PARAMS[3]}" | tr -d '"' | xargs)
        username=$(echo "${PARAMS[4]}" | tr -d '"' | xargs)
        password=$(echo "${PARAMS[5]}" | tr -d '"' | xargs)
        port1=$(echo "${PARAMS[6]}" | tr -d '"' | xargs)
        port2=$(echo "${PARAMS[7]}" | tr -d '"' | xargs)
        domain=$(echo "${PARAMS[8]}" | tr -d '"' | xargs)

        # Everything after the domain: MAC address(es) (up to two) and optional
        # host=<fqdn> / ip=<address> options, in any order. Empty tokens are ignored.
        mac1=""
        mac2=""
        for ((i = 9; i < ${#PARAMS[@]}; i++)); do
            tok=$(echo "${PARAMS[$i]}" | tr -d '"' | xargs)
            [ -z "$tok" ] && continue
            if [[ "$tok" == ip=* || "$tok" == host=* ]]; then
                continue
            elif [[ "$tok" =~ ^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$ ]]; then
                if [ -z "$mac1" ]; then
                    mac1="$tok"
                elif [ -z "$mac2" ]; then
                    mac2="$tok"
                else
                    echo "WARNING: '$container_name' lists more than two MACs; ignoring $tok" >&2
                fi
            else
                echo "WARNING: ignoring unrecognized option '$tok' for '$container_name'" >&2
            fi
        done
        host_override=$(get_option host "${PARAMS[@]:9}")
        static_ip=$(get_option ip "${PARAMS[@]:9}")

        if [ "$os_type" != "windows" ] && [ "$os_type" != "macos" ]; then
            echo "ERROR: Container '$container_name' has unrecognized os '$os_type' (expected 'windows' or 'macos'). Skipping."
            skipped+=("$container_name (unrecognized os '$os_type')")
            continue
        fi
        
        # Check if USB devices are required and can be found
        usb_devices_found=true
        missing_macs=""
        
        if [ -n "$mac1" ]; then
            usb1=$(find_usb_device "$mac1")
            if [ -z "$usb1" ]; then
                usb_devices_found=false
                missing_macs="$mac1"
            fi
        fi
        
        if [ -n "$mac2" ]; then
            usb2=$(find_usb_device "$mac2")
            if [ -z "$usb2" ]; then
                usb_devices_found=false
                if [ -n "$missing_macs" ]; then
                    missing_macs="$missing_macs, $mac2"
                else
                    missing_macs="$mac2"
                fi
            fi
        fi
        
        # If USB devices are required but not found, skip folder creation
        if [ "$usb_devices_found" = "false" ]; then
            echo "WARNING: Skipping container '$container_name' - USB device(s) not found for MAC address(es): $missing_macs"
            skipped+=("$container_name (USB device not found: $missing_macs)")
            continue
        fi
        
        # Create folder for container. The parameters.txt key may contain
        # "/" to group VMs under a workshop folder (e.g. "nw3/win1" ->
        # nw3/win1/docker-compose.yml) -- mkdir -p handles that directly.
        # Docker container names/hostnames can't contain "/", so those use
        # a sanitized "-"-joined form instead (e.g. "nw3-win1").
        container_dir="$SCRIPT_DIR/$container_name"
        docker_name="${WORKSHOP_NAME}-$(echo "$container_name" | tr '/' '-')"
        mkdir -p "$container_dir"

        # Generate docker-compose.yml
        generate_docker_compose "$docker_name" "$os_type" "$version" "$ram_size" "$cpu_cores" \
            "$username" "$password" "$port1" "$port2" "$domain" "$mac1" "$mac2" "$TRAEFIK_INSTALLED" \
            "$host_override" "$static_ip" > \
            "$container_dir/docker-compose.yml"

        echo "Generated docker-compose.yml for $container_name in $container_dir"
        generated+=("$container_name")
    fi
done < "$PARAMETERS_FILE"

echo ""
echo "Done. Generated ${#generated[@]}, skipped ${#skipped[@]}."
if [ ${#skipped[@]} -gt 0 ]; then
    echo "Skipped (any existing docker-compose.yml for these was left as-is):"
    for s in "${skipped[@]}"; do echo "  - $s"; done
fi

