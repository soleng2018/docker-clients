[Unit]
Description=Regenerate and start every docker-clients testbed VM (fixes stale USB hostbus/hostaddr after a host reboot)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__REPO_DIR__
ExecStart=__REPO_DIR__/reconcile.sh

[Install]
WantedBy=multi-user.target
